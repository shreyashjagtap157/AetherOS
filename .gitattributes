# AetherOS gitattributes - enterprise-grade configuration
# Enforce LF line endings for all text files
* text=auto eol=lf

# Documentation
*.md text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab,trailing-space
*.txt text eol=lf

# Rust
*.rs text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab,trailing-space
Cargo.toml text eol=lf
Cargo.lock text eol=lf

# Configuration
*.toml text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab,trailing-space
*.yaml text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab,trailing-space
*.yml text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab,trailing-space
*.json text eol=lf
*.jsonc text eol=lf

# Scripts
*.sh text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab,trailing-space
*.py text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab,trailing-space

# Binary assets (if any)
*.png binary
*.jpg binary
*.ico binary
*.svg binary

# Generated artifacts - never commit
artifacts/ -text
*.log -text

# Diff drivers for better code review
*.rs diff=rust
*.md diff=markdown
*.toml diff=toml
*.yaml diff=yaml
*.yml diff=yaml